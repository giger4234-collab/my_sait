  "narrative": {
    "northStar": "The Lacquer Orbit",
    "overview": "A dark editorial web studio: oversized Russian typography, generous pauses, and abstract red lacquer and chrome forms. The visual reference is the immersive, long-scroll character of lusion.co; the implementation uses its own orbital mark, geometry, copy, and composition.\n\nThe scene is the primary visual material. Compact controls and quiet supporting text frame it, while the red contact field gives the scroll a clear destination. ОРБИТА remains the brand; ВЕБ СТУДИЯ is the header descriptor. Earth, Mars, and Saturn remain an interactive atlas within this world.",
    "keyCharacteristics": [
      "Near-black stages, warm text, and a single red UI accent.",
      "Large editorial headings with small, precise controls.",
      "Real-time lacquer and chrome geometry with a static poster alternative.",
      "Asymmetric, spacious sections that collapse into a clear mobile sequence."
    ],
    "rules": [
      {
        "name": "The Material Rule",
        "body": "Use red for primary actions, selection, and the scene material; retain warm neutrals for reading and structure.",
        "section": "colors"
      },
      {
        "name": "The Scale Rule",
        "body": "Let headlines supply emphasis through size and tight tracking; keep supporting text quieter and comfortably spaced.",
        "section": "typography"
      },
      {
        "name": "The Stage Rule",
        "body": "Create depth through the artwork and tonal separation. Reserve interface shadows for the open navigation panel.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the dark red-and-black studio direction, orbital mark, and ВЕБ СТУДИЯ descriptor.",
      "Do give the abstract forms generous space and alternate full-width and offset compositions.",
      "Do use local Manrope, visible keyboard focus, and the existing 44px-or-larger control targets.",
      "Do preserve the static poster, mobile opt-in, and reduced-motion reading path.",
      "Do retain the three-planet atlas and the Telegram contact @webdiz3d."
    ],
    "donts": [
      "Don't substitute a generic card grid for the large scene-led editorial rhythm.",
      "Don't replace the lacquer and chrome material language with unrelated visual effects.",
      "Don't hide essential copy behind an animation or require WebGL to reach content.",
      "Don't invent client work, testimonials, or commercial proof to fill the layout."
    ]
  }
}
